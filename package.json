{
  "name": "sheeplink-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run sync:plans && npm run build:offline",
    "test": "node --experimental-strip-types --test tests/*.test.cjs tests/*.test.ts",
    "format": "prettier --write src tests scripts vite.config.ts",
    "format:check": "prettier --check src tests scripts vite.config.ts",
    "generate:og": "node scripts/social-image.mjs",
    "sync:plans": "node scripts/sync-plans.mjs",
    "build:offline": "tsc --noEmit && vite build && vite build --ssr scripts/prerender.tsx --outDir .prerender && node scripts/prerender.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "3.6.2",
    "sharp": "0.35.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
